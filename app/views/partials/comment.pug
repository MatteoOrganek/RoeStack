mixin commentItem(comment, content)
   .comment-thread(
    class=[comment.replies && comment.replies.length > 0 ? 'has-replies' : '',
        comment.isDeleted ? 'deleted' : ''])
        .comment-body
            .comment-left
                if comment.user.images && comment.user.images.length > 0
                    img.avatar(src=`https://owres.org/roestack/${comment.user.images[0].url}` alt=comment.user.name loading="lazy")
                else
                    img.avatar(src="/images/none-avatar.svg" alt="User Avatar")
            .comment-right
                .comment-info
                    //- JE - If the comment author is banned, show [removed] instead of their name and remove the profile link.
                    if comment.user.isBanned
                        span.name [removed]
                    else
                        a.name(href="/user/" + comment.user.id)= comment.user.name
                    span.dot •
                    span.time= comment.elapsedTime
                    button.icon-btn(type="button" onclick="toggleMenu(this)")
                        img.options(src="/images/icons/three-vertical-dots.svg" alt="Options Icon")
                    if !comment.isDeleted
                        ul.dropdown-menu
                            if content.session.user.id === comment.user.id || Number(content.session.user.isMod) === 1 
                                li 
                                    a.delete-comment(
                                        href="#"
                                        data-comment-id=comment.id
                                        style="color: red;"
                                    ) Delete comment
                            else 
                                li 
                                    a(href="#" style="color: red;") Report comment
                .role= comment.user.role

                p.comment-text= comment.content

                if !comment.isDeleted
                    .comment-footer
                        .interactions
                            button.upvote(
                                data-id=comment.id,
                                data-type-id=1,
                                class=comment.currentUserVote === 1 ? "active" : ""
                                )
                                img.vote-icon(src="/images/icons/up-vote.svg" alt="Upvote Icon")

                            span.vote-count 
                                span= comment.amountVotes

                            button.downvote(
                                data-id=comment.id,
                                data-type-id=1,
                                class=comment.currentUserVote === -1 ? "active" : ""
                                )
                                img.vote-icon(src="/images/icons/down-vote.svg" alt="Downvote Icon")
                        a.answers(href="#" data-comment-id=comment.id)
                            img.answer-icon(src="/images/icons/chat-left.svg" alt="Answer Icon")
                            p.reply Reply
                    

        // REPLIES    
        if comment.replies
            .replies
                each reply in comment.replies
                    +commentItem(reply, content)
                    
template#reply-template
  .reply-form
    input.reply-input(type="text" placeholder="Write a reply...")
    button.reply-btn() Reply
